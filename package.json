{
  "name": "multi-agent-story", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1", "build": "next build", "start": "npm run db:migrate && next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts", "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts", "typecheck": "tsc --noEmit",
    "test": "vitest run", "test:integration": "tsx --env-file-if-exists=.env scripts/integration.ts", "test:recovery": "tsx scripts/recovery.ts", "test:e2e": "playwright test",
    "agents:read": "tsx --env-file-if-exists=.env scripts/read-harness.ts", "agents:trace": "tsx scripts/read-trace.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48", "@langchain/langgraph": "1.5.1", "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "better-auth": "1.7.12", "drizzle-orm": "^0.45.2", "next": "16.4.2", "pg": "^8.16.0", "pg-boss": "12.38.0",
    "react": "^19.2.0", "react-dom": "^19.2.0", "tsx": "^4.21.0", "zod": "^4.2.0"
  },
  "overrides": { "esbuild": "0.28.2" },
  "devDependencies": {
    "@playwright/test": "^1.58.0", "@types/node": "^24.0.0", "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.0", "vitest": "^4.0.0"
  }
}
