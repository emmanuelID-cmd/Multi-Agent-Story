# Local synthetic foundation only. Generate distinct local values; never commit .env.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://story:YOUR_LOCAL_PASSWORD@127.0.0.1:54329/story
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NYT_BOOKS_API_KEY=
LIVE_BOOK_METADATA=false
BOOK_METADATA_TERMS_REVIEWED=false
# READ harness calls Claude only with its explicit --live flag. Keys stay server-side.
ANTHROPIC_API_KEY=
# The web workspace still uses fixtures. Metadata reads retain their separate gates above.
# Explicit READ application endpoint opt-in; worker and UI retain their existing defaults.
READ_CONNECTIONS_ENABLED=false
# Populate verified deployment rates before enabling; no assumed provider pricing.
READ_INPUT_USD_PER_MILLION=
READ_OUTPUT_USD_PER_MILLION=
